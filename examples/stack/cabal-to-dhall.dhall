                                                                    , package =
                                                                        "array"
                                                                    }
                                                                  , { bounds =
                                                                        prelude.anyVersion
                                                                    , package =
                                                                        "async"
                                                                    }
                                                                  , { bounds =
                                                                        prelude.anyVersion
                                                                    , package =
                                                                        "attoparsec"
                                                                    }
                                                                  , { bounds =
                                                                        prelude.intersectVersionRanges
                                                                        ( prelude.unionVersionRanges
                                                                          ( prelude.thisVersion
                                                                            ( prelude.v
                                                                              "4.14.3.0"
                                                                            )
                                                                          )
                                                                          ( prelude.laterVersion
                                                                            ( prelude.v
                                                                              "4.14.3.0"
                                                                            )
                                                                          )
                                                                        )
